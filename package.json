{
  "name": "meteocool",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-local": "vite --mode localstack",
    "build": "vite build",
    "preview": "vite preview",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "worker:dev": "wrangler dev",
    "worker:tail": "wrangler tail",
    "check": "svelte-check --tsconfig ./tsconfig.json && tsc -p tsconfig.worker.json && eslint .",
    "test": "node --test \"scripts/tests/**/*.test.ts\"",
    "generate:api": "openapi-typescript spec/api.openapi.json -o src/api/generated/api.ts && openapi-typescript spec/data.openapi.json -o src/api/generated/data.ts",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@sentry/browser": "^8.55.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "chart.js": "^4.4.9",
    "chartjs-chart-error-bars": "^4.4.4",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.1.0",
    "idb": "^8.0.3",
    "javascript-state-machine": "^3.1.0",
    "nanobar": "^0.4.2",
    "ol": "^10.10.0",
    "openapi-fetch": "^0.17.0",
    "socket.io-client": "^4.8.1",
    "svelte-i18n": "^4.0.1",
    "workbox-window": "^7.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260911.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^26.5.1",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.39.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.4.3",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-static-copy": "^2.3.1",
    "workbox-cacheable-response": "^7.3.0",
    "workbox-core": "^7.3.0",
    "workbox-expiration": "^7.3.0",
    "workbox-precaching": "^7.3.0",
    "workbox-routing": "^7.3.0",
    "workbox-strategies": "^7.3.0",
    "wrangler": "^4.131.1"
  }
}
