{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "meteocool",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 8080
    },
    {
      "name": "meteocool-staging-alt",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "8091",
        "--strictPort"
      ],
      "port": 8091
    },
    {
      "name": "meteocool-demo",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "MC_API=https://api-demo.meteocool.com",
        "MC_DATA=https://data-demo.meteocool.com",
        "MC_TILES=https://assets-demo.meteocool.com",
        "npx",
        "vite",
        "--port",
        "8097",
        "--strictPort"
      ],
      "port": 8097
    },
    {
      "name": "meteocool-staging-8098",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "vite",
        "--port",
        "8098",
        "--strictPort"
      ],
      "port": 8098
    }
  ]
}
