{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "name": "meteocool Rain Radar",
  "short_name": "meteocool",
  "start_url": "/",
  "display": "standalone",
  "description": "Free 3D rain radar for Europe with live rain, lightning and storm cell tracking, plus super-accurate push notifications, column maximum, VIL, Echo Tops and much more. Open source since 2018, for iOS, Android and the web. Chase it or avoid it.",
  "background_color": "#fff",
  "icons": [{
    "src": "assets/logo-192.png",
    "sizes": "192x192",
    "type": "image/png"
  }, {
    "src": "assets/logo.png",
    "sizes": "512x512",
    "type": "image/png"
  }],
  "related_applications": [{
    "platform": "play",
    "url": "https://play.google.com/store/apps/details?id=com.meteocool"
  }, {
    "platform": "itunes",
    "url": "https://apps.apple.com/de/app/meteocool-regenradar/id1438364623"
  }],
  "prefer_related_applications": true
}
