{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Not `meteocool`: that is the account's existing production Worker, and a
  // bare `wrangler deploy` with this name would overwrite it. Every env below
  // names itself.
  "name": "meteocool-web",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-01",

  // `run_worker_first` is what makes the OpenGraph injection possible at all:
  // without it Cloudflare serves index.html straight from the asset store and
  // the Worker never sees the request.
  //
  // No `not_found_handling`: this is a multi-page build (index, ios, android,
  // imprint, privacy), not an SPA, so a missing asset should 404 rather than be
  // rewritten to index.html.
  //
  // `html_handling: "none"`: by default Cloudflare 307s /ios.html to /ios. The
  // iOS and Android wrappers load ios.html and android.html by name, so those
  // URLs have to keep resolving directly.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
  },

  // Three environments, one per Worker and Vite mode: `production` from
  // `main`, `next` and `demo` from `develop` (.github/workflows). Build each
  // with its own `--mode`, as its deploy script does; production's is Vite's
  // default.
  //
  // A custom domain belongs to one Worker at a time, and a deploy from CI
  // takes it over without asking. Never list a hostname in two environments,
  // or each deploy steals it back from the other.
  //
  // In each: API_ORIGIN is where the apps' API calls are forwarded, and
  // DATA_ORIGIN and ASSET_ORIGIN what the iOS app's AR view reads through the
  // Worker (worker/api.ts). PREVIEW_ORIGIN names the API whose preview cards
  // the OpenGraph tags advertise: the Worker is bundled by wrangler, so Vite's
  // `--mode` never reaches it. The preview Worker is bound as a service rather
  // than fetched, which from a Worker in the same zone would skip its route.
  "env": {
    // meteocool.com, and app.meteocool.com, where the native apps load their
    // map and send their push registrations. Production shares next's
    // backend until it has one of its own.
    "production": {
      "name": "meteocool-production",
      "compatibility_date": "2026-09-20",
      "logpush": true,
      "workers_dev": false,
      "routes": [
        { "pattern": "meteocool.com", "custom_domain": true },
        { "pattern": "app.meteocool.com", "custom_domain": true },
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true },
        "traces": { "enabled": true },
      },
      "vars": {
        "PREVIEW_ORIGIN": "https://api-next.meteocool.com",
        "API_ORIGIN": "https://api-next.meteocool.com",
        "DATA_ORIGIN": "https://data-staging.meteocool.com",
        "ASSET_ORIGIN": "https://assets-staging.meteocool.com",
      },
      "services": [{ "binding": "PREVIEW", "service": "meteocool-preview" }],
    },
    // next.meteocool.com: what develop holds, on the live feeds.
    "next": {
      "name": "meteocool-next",
      "compatibility_date": "2026-09-20",
      "logpush": true,
      "workers_dev": true,
      "routes": [
        { "pattern": "next.meteocool.com", "custom_domain": true },
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true },
        "traces": { "enabled": true },
      },
      "vars": {
        "PREVIEW_ORIGIN": "https://api-next.meteocool.com",
        "API_ORIGIN": "https://api-next.meteocool.com",
        "DATA_ORIGIN": "https://data-staging.meteocool.com",
        "ASSET_ORIGIN": "https://assets-staging.meteocool.com",
      },
      "services": [{ "binding": "PREVIEW", "service": "meteocool-preview" }],
    },
    // demo.meteocool.com: develop again, on a backend replaying a recorded storm.
    "demo": {
      "name": "meteocool-demo",
      "compatibility_date": "2026-09-20",
      "logpush": true,
      "workers_dev": true,
      "routes": [
        { "pattern": "demo.meteocool.com", "custom_domain": true },
      ],
      "observability": {
        "enabled": true,
        "logs": { "enabled": true },
        "traces": { "enabled": true },
      },
      "vars": {
        "PREVIEW_ORIGIN": "https://api-demo.meteocool.com",
        "API_ORIGIN": "https://api-demo.meteocool.com",
        "DATA_ORIGIN": "https://data-demo.meteocool.com",
        "ASSET_ORIGIN": "https://assets-demo.meteocool.com",
      },
      "services": [{ "binding": "PREVIEW", "service": "meteocool-preview" }],
    },
  },
}
