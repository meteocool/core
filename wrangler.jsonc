{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "meteocool",
  "main": "./src/worker.js",
  "compatibility_date": "2025-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // "routes": [
  //   {
  //     "pattern": "meteocool.com",
  //     "zone_name": "meteocool.com",
  //   },
  //   {
  //     "pattern": "www.meteocool.com",
  //     "zone_name": "meteocool.com",
  //   },
  // ],
  "env": {
    // "production": {
    //   "routes": [
    //     {
    //       "pattern": "meteocool.com",
    //       "zone_name": "meteocool.com",
    //     },
    //     {
    //       "pattern": "www.meteocool.com",
    //       "zone_name": "meteocool.com",
    //     },
    //   ],
    // },
    "staging": {
      "name": "meteocool-vibeocool",
      "workers_dev": false,
      "route": {
        "pattern": "vibeocool.meteocool.com",
        "custom_domain": true,
      },
    },
    "development": {
      "name": "meteocool-dev",
    },
  },
}
