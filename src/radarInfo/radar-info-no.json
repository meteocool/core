  "norst": {
    "operator": "MET Norway",
    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2021",
    "towerM": 12,
    "text": {
      "en": "Stands at Langneset near the airport on Røst, the low-lying outermost island group of Lofoten. With its antenna only 17 m above sea level it is the lowest radar in MET Norway's network, watching Lofoten, Ofoten, Salten and the fishing banks offshore. Opened in 2004, upgraded to dual polarisation in 2021."
    },
    "photo": null,
    "sources": [
      "https://www.eumetnet.eu/wp-content/themes/aeron-child/observations-programme/current-activities/opera/database/OPERA_Database/OPERA_RADARS_DB.json",
