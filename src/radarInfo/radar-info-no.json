  "nohgb": {
    "operator": "MET Norway",
    "system": "Leonardo METEOR 735CDP10",
    "band": "C",
    "dualPol": true,
    "since": "2017",
    "towerM": 7,
    "text": {
      "en": "Stands on Stakksteinsliknuten in the Toreshei area of Hægebostad in Agder, 631 m above sea level, and watches Sørlandet, Rogaland and part of the Skagerrak. It was the first radar in MET Norway's network, in service since 2000, and was upgraded to a dual-polarisation Leonardo radar in 2017."
    },
