    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2016",
    "towerM": 12,
    "text": {
      "en": "Stands at Treillières, just north of Nantes in the Loire-Atlantique. Its C-band beam covers the lower Loire, the Vendée coast and southern Brittany. The current radar dates from 2016."
    },
    "photo": null,
