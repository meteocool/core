  "fraja": {
    "operator": "Météo-France",
    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2018",
    "towerM": 4,
    "text": {
      "en": "Sits on the summit of La Punta, about 780 m up in the hills above Ajaccio. It covers Corsica's west coast and complements the Aléria radar, whose view is limited mostly to the east of the island. Installed in December 2017, it became operational in July 2018."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMYV6WrNMPrOP2T3ZOC4qwJXoFucISKZkpmIbPyt4Qjey",
