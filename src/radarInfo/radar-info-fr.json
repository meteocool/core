      "https://www.corsenetinfos.corsica/Ajaccio-Le-nouveau-radar-de-la-Punta-operationnel_a35595.html"
    ]
  },
  "frave": {
    "operator": "Météo-France",
    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2005",
    "towerM": 17,
    "text": {
      "en": "Stands in the Avesnois, west of Avesnes-sur-Helpe in the far north of France, near the Belgian border. Its C-band beam covers the Nord department, the edge of the Ardennes and parts of Wallonia. In service since 2005."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMaDGBwyLcbzCUjSwupN2SbPN0WPfnR6ebkdHDWESiHLW",
      "https://www.eumetnet.eu/wp-content/themes/aeron-child/observations-programme/current-activities/opera/database/OPERA_Database/OPERA_RADARS_DB.json"
    ]
  },
  "frbla": {
    "operator": "Météo-France",
    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2006",
    "towerM": 15,
    "text": {
      "en": "Stands at about 590 m on the limestone uplands west of Dijon in the Côte-d'Or. From this height its C-band beam covers Burgundy, the Saône plain and the Morvan. In service since 2006."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMbDG7WhzmSdud3_Tm5Vll3JNVvMGY-6oplwiDoeNsIKJ",
