      "https://www.corsenetinfos.corsica/Ajaccio-Le-nouveau-radar-de-la-Punta-operationnel_a35595.html"
    ]
  },
  "frale": {
    "operator": "Météo-France",
    "system": "Thomson",
    "band": "S",
    "dualPol": null,
    "since": null,
    "towerM": 13,
    "text": {
      "en": "Stands on Corsica's flat eastern plain near Aléria, close to the Tyrrhenian coast. The S-band radar watches eastern Corsica and the sea towards Italy; since 2018 a second radar near Ajaccio covers the west of the island. It has been in service since the early 2000s."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMS9u99jd5cpzN31hyUonubtT_CNYmiXM2PCgJVE1wKVV",
