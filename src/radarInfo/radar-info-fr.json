      "https://fr.wikipedia.org/wiki/Blaisy-Haut"
    ]
  },
  "frbol": {
    "operator": "Météo-France",
    "system": "Thomson",
    "band": "S",
    "dualPol": null,
    "since": null,
    "towerM": 16,
    "text": {
      "en": "Stands on a hill above the Rhône valley near Bollène in northern Vaucluse. It was pushed for after the deadly Vaison-la-Romaine flood of 1992 to watch heavy rain over the lower Rhône and its tributaries; construction began in 1998. Like the other Mediterranean radars it uses the S band."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMUl2VFa8NNP_01wDA68L0R_B_keKwJIdk5Hq63h-0vfs",
