    "operator": "Météo-France",
    "system": "Selex",
    "band": "C",
    "dualPol": true,
    "since": "2014",
    "towerM": 12,
    "text": {
      "en": "Stands just north-east of Falaise, south of Caen in Calvados. Its C-band beam covers Lower Normandy, the Channel coast and the sea towards England. The current dual-polarisation radar went into service in 2014."
    },
    "photo": null,
    "sources": [
      "https://wrd.mgm.gov.tr/Radar/Detail/V1JEMZoBreC-GX-ZQGhRaWx1OEFmnVbi3vffyEcU1d90VWXF",
