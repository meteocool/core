  "fikau": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2025",
    "towerM": 30,
    "text": {
      "en": "Finland's northernmost weather radar, standing near the summit of Kaunispää fell above the Saariselkä resort in Inari. In service since March 2025, it is the twelfth and newest radar in FMI's network and mainly improves coverage of northern Lapland, for example for winter road maintenance."
    },
