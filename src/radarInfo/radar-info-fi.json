  },
  "finur": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2019",
    "towerM": 33,
    "text": {
      "en": "Stands on Riihivaara hill at Mujejärvi in Nurmes, North Karelia. Completed in November 2019 as the eleventh radar of the network, it mainly improves coverage of Kainuu, North Karelia and North Savo in eastern Finland."
    },
    "photo": null,
    "sources": [
