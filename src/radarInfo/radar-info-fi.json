      "https://www.ilmatieteenlaitos.fi/havaintoasemat",
      "https://yle.fi/a/3-5909308"
    ]
  },
  "fikan": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2022",
    "towerM": null,
    "text": {
      "en": "Stands on the Ylisenharju ridge in Kankaanpää, Satakunta, and covers western Finland out towards the Gulf of Bothnia. The radar was moved here in spring 2022 from the Ikaalinen water tower, about 30 km away, where it had operated since 2010, because the water tower was due for renovation."
    },
    "photo": null,
    "sources": [
