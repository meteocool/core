  "fikes": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2015",
    "towerM": 30.6,
    "text": {
      "en": "Stands at Kesälahti in Kitee, North Karelia. Built in 2014 as the ninth radar of the network, it watches eastern Finland and can pick up summer storms and low winter snowfall approaching from the direction of Lake Ladoga hours earlier than before."
    },
    "photo": null,
    "sources": [
