{
  "fianj": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2009",
    "towerM": null,
    "text": {
      "en": "Sits on top of the Kaipiainen water tower in Kouvola and watches southeastern Finland, where severe storms sometimes arrive from the Karelian Isthmus. The site has been in use since the early 1990s; its current radar, put into service in October 2009, was only the second dual-polarisation radar in Finland."
    },
    "photo": null,
    "sources": [
      "https://www.eumetnet.eu/wp-content/themes/aeron-child/observations-programme/current-activities/opera/database/OPERA_Database/OPERA_RADARS_DB.json",
