  "fikuo": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2013",
    "towerM": null,
    "text": {
      "en": "Stands at Rytky in Kuopio and covers the lake district of eastern central Finland. The site dates from 1995; its dual-polarisation radar went into service in autumn 2013. FMI notes it is particularly useful for air traffic in the region, since it shows which parts of a cloud hold water and which hold ice."
    },
    "photo": null,
    "sources": [
      "https://www.eumetnet.eu/wp-content/themes/aeron-child/observations-programme/current-activities/opera/database/OPERA_Database/OPERA_RADARS_DB.json",
