  "filuo": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2014",
    "towerM": null,
    "text": {
      "en": "Stands on the bare summit of Ukko-Luosto, more than 500 m above sea level, in the Pyhä-Luosto fells of Sodankylä, and covers central Lapland. The site has been in use since 2000 and its dual-polarisation radar since July 2014. With Lapland's long distances, its data matter especially for winter road maintenance."
    },
    "photo": null,
    "sources": [
      "https://www.eumetnet.eu/wp-content/themes/aeron-child/observations-programme/current-activities/opera/database/OPERA_Database/OPERA_RADARS_DB.json",
