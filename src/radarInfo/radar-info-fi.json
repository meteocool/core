  "fikor": {
    "operator": "FMI",
    "system": "Vaisala WRM200",
    "band": "C",
    "dualPol": true,
    "since": "2012",
    "towerM": 29,
    "text": {
      "en": "Stands at Rumar on the island of Korpo in the Turku archipelago and has watched the Archipelago Sea since 1997, replacing an older radar on the Masku water tower. The tower has a public viewing platform at 14 m, popular with travellers on the Archipelago Trail. The current dual-polarisation radar was installed in 2012."
    },
