  "dksam": {
    "operator": "DMI",
    "system": "Vaisala",
    "band": "C",
    "dualPol": true,
    "since": "2024",
    "towerM": 20,
    "text": {
      "en": "DMI's newest radar stands on a 20 m steel lattice tower just north of the village of Permelille on Samsø, an island in the middle of the Kattegat. Its 7 m dome went up in August 2023, and the radar took over from the old radar at Virring near Skanderborg; it reaches about 240 km."
    },
    "photo": null,
    "sources": [
