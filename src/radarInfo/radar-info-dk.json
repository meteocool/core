  "dksin": {
    "operator": "DMI",
    "system": "Vaisala",
    "band": "C",
    "dualPol": true,
    "since": "2017",
    "towerM": null,
    "text": {
      "en": "DMI's northernmost radar stands near Sindal in Vendsyssel, the tip of Jutland, and covers the Skagerrak, the northern Kattegat and the coasts of Norway and Sweden. A radar has worked here since 1994; it was the first site to get a new dual-polarisation radar, in spring 2017."
    },
    "photo": null,
    "sources": [
