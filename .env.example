# Copy to .env.local to override the committed defaults in .env.

# Version of the Protomaps basemap tileset served from map.meteocool.com.
# src/layers/protomaps.ts falls back to a build-time default if this is unset,
# so a build without it produces a working map rather than URLs containing the
# literal string "undefined".
VITE_MAP_VERSION=20260104
