# Environment variables for meteocool application
# CRITICAL: This file must be kept in sync with actual environment variables used in the codebase

# =============================================================================
# REQUIRED VARIABLES - MUST be set for application to function
# =============================================================================

# Map tile version - CRITICAL for map functionality
# This version string is used in map tile URLs (map.meteocool.com/{version}/)
# PRODUCTION: Set to current map version (e.g., 20250602)
# DEVELOPMENT: Use same as production or override locally
VITE_MAP_VERSION=20250602

# Sentry DSN for error tracking
# PRODUCTION: Set to actual Sentry project DSN
# DEVELOPMENT: Can be empty or use development DSN
VITE_SENTRY_DSN=

# =============================================================================
# OPTIONAL VARIABLES - Have sensible defaults
# =============================================================================

# Backend API URL override (optional)
# DEFAULT: Uses production API at https://api.meteocool.com
# DEVELOPMENT: Set to http://localhost:8000 for local backend
# VITE_BACKEND_URL=https://api.meteocool.com

# =============================================================================
# CI/CD INSTRUCTIONS
# =============================================================================
# 
# For CI/CD pipelines:
# 1. Set VITE_MAP_VERSION to match your map tile deployment version
# 2. Set VITE_SENTRY_DSN to your production Sentry DSN
# 3. Set NODE_ENV=production for production builds
# 4. Optionally set VITE_BACKEND_URL if using custom backend
#
# Example CI environment variables:
# VITE_MAP_VERSION=20250602
# VITE_SENTRY_DSN=https://abc123@sentry.io/123456
# NODE_ENV=production