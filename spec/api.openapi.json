{
  "components": {
    "schemas": {
      "CellsRefresh": {
        "description": "A nudge that a new KONRAD3D reference time is available.\n\nDeliberately not a `Poke`: the frontend's only `poke` handler reloads every\nradar tile, and deliberately not the cells themselves, which run to hundreds\nof kilobytes on a severe day. Clients refetch `/cells/*` from the data\nservice, scoped to their viewport.",
        "properties": {
          "count": {
            "description": "Convective cells detected in that run",
            "title": "Count",
            "type": "integer"
          },
          "max_severity": {
            "description": "Highest DWD severity class in the run",
            "maximum": 3,
            "minimum": 0,
            "title": "Max Severity",
            "type": "integer"
          },
          "reference_time": {
            "description": "Reference time of the run, milliseconds since the epoch",
            "title": "Reference Time",
            "type": "integer"
          }
        },
        "required": [
          "reference_time",
          "count",
          "max_severity"
        ],
        "title": "CellsRefresh",
        "type": "object"
      },
      "ClassTiles": {
        "description": "What a precipitation-type tile set holds: a byte per HG class, not colours.",
        "properties": {
          "encoding": {
            "const": "hg-class-u8",
            "description": "Single-band 8-bit greyscale PNG; pixel = HG class as a byte: 1 not classifiable, 2 drizzle, 3 rain, 4 snow, 5 sleet, 6 graupel, 7 hail; 0 draws nothing. A byte keeps its class; a new class takes a new byte.",
            "title": "Encoding",
            "type": "string"
          },
          "tile_id": {
            "description": "The tile set, at the same place as `tile_id`'s.",
            "title": "Tile Id",
            "type": "string"
          }
        },
        "required": [
          "tile_id",
          "encoding"
        ],
        "title": "ClassTiles",
        "type": "object"
      },
      "ClearNotification": {
        "description": "An acknowledgement that a delivered notification was seen.",
        "properties": {
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "token": {
            "maxLength": 192,
            "minLength": 32,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "ClearNotification",
        "type": "object"
      },
      "Coverages": {
        "description": "Which domain answers for which ground: the map draws by this, and the server decides by it.",
        "properties": {
          "crs": {
            "description": "The rings' projection: EPSG:3857, the map's own.",
            "title": "Crs",
            "type": "string"
          },
          "domains": {
            "additionalProperties": {
              "$ref": "#/components/schemas/NetworkCoverage"
            },
            "description": "Each EUMETNET network, by domain. DWD's (`de`) is wherever its grid reaches and none of these.",
            "title": "Domains",
            "type": "object"
          },
          "priority": {
            "description": "Who wins outside every network's own borders where several reach, first to last.",
            "items": {
              "type": "string"
            },
            "title": "Priority",
            "type": "array"
          }
        },
        "required": [
          "crs",
          "priority",
          "domains"
        ],
        "title": "Coverages",
        "type": "object"
      },
      "FrameSource": {
        "description": "Where a timestep's values came from.\n\nDeclared as an enum so it reaches the exported OpenAPI schema as one, and\nthe frontend's generated client types `source` as a union rather than a bare\nstring. It was a plain `str`, which is how the two deployments came to emit\ndifferent words for a forecast -- `nowcast_phys` in production, `forecast`\nhere -- without the contract, the generated client or any test noticing.\n\nThe values are production's, because shipped clients already read them:\n`precacheAllForecasts()` matches `nowcast_phys` literally.",
        "enum": [
          "observation",
          "nowcast_phys"
        ],
        "title": "FrameSource",
        "type": "string"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "Language": {
        "description": "Languages notifications are written in.",
        "enum": [
          "de",
          "en"
        ],
        "title": "Language",
        "type": "string"
      },
      "LightningCollection": {
        "description": "Strikes since a baseline.",
        "properties": {
          "baseline": {
            "title": "Baseline",
            "type": "integer"
          },
          "strikes": {
            "items": {
              "$ref": "#/components/schemas/LightningStrike"
            },
            "title": "Strikes",
            "type": "array"
          }
        },
        "required": [
          "strikes",
          "baseline"
        ],
        "title": "LightningCollection",
        "type": "object"
      },
      "LightningLayerMetadata": {
        "description": "Metadata for the lightning vector tile layer.",
        "properties": {
          "most_recent_strike": {
            "title": "Most Recent Strike",
            "type": "integer"
          },
          "num_strikes": {
            "title": "Num Strikes",
            "type": "integer"
          },
          "processed_time": {
            "title": "Processed Time",
            "type": "integer"
          },
          "tile_id": {
            "title": "Tile Id",
            "type": "string"
          }
        },
        "required": [
          "processed_time",
          "tile_id",
          "most_recent_strike",
          "num_strikes"
        ],
        "title": "LightningLayerMetadata",
        "type": "object"
      },
      "LightningStats": {
        "description": "Strike counts per time bin for an area.",
        "properties": {
          "bin_size_min": {
            "title": "Bin Size Min",
            "type": "integer"
          },
          "bins": {
            "items": {
              "type": "integer"
            },
            "title": "Bins",
            "type": "array"
          },
          "time": {
            "title": "Time",
            "type": "number"
          }
        },
        "required": [
          "time",
          "bins",
          "bin_size_min"
        ],
        "title": "LightningStats",
        "type": "object"
      },
      "LightningStrike": {
        "description": "One strike, in projected metres, as the frontend expects.",
        "properties": {
          "lat": {
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "title": "Lon",
            "type": "number"
          },
          "time_wall": {
            "title": "Time Wall",
            "type": "integer"
          }
        },
        "required": [
          "lat",
          "lon",
          "time_wall"
        ],
        "title": "LightningStrike",
        "type": "object"
      },
      "LocationUpdate": {
        "description": "A push client's location and notification preferences.",
        "properties": {
          "accuracy": {
            "title": "Accuracy",
            "type": "number"
          },
          "ahead": {
            "description": "Notify this many minutes ahead",
            "exclusiveMinimum": 0.0,
            "maximum": 60.0,
            "title": "Ahead",
            "type": "integer"
          },
          "intensity": {
            "description": "Threshold in dbZ",
            "maximum": 130.0,
            "minimum": 0.0,
            "title": "Intensity",
            "type": "integer"
          },
          "lang": {
            "$ref": "#/components/schemas/Language",
            "default": "en"
          },
          "lat": {
            "description": "EPSG:4326 latitude",
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "EPSG:4326 longitude",
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "source": {
            "$ref": "#/components/schemas/Platform"
          },
          "speed": {
            "default": 0.0,
            "title": "Speed",
            "type": "number"
          },
          "token": {
            "maxLength": 192,
            "minLength": 32,
            "title": "Token",
            "type": "string"
          },
          "withDBZ": {
            "default": false,
            "title": "Withdbz",
            "type": "boolean"
          }
        },
        "required": [
          "lat",
          "lon",
          "source",
          "token",
          "ahead",
          "intensity",
          "accuracy"
        ],
        "title": "LocationUpdate",
        "type": "object"
      },
      "Mesocyclone": {
        "description": "One DWD mesocyclone detection. The `mesocyclones` event carries a list.",
        "properties": {
          "diameter": {
            "description": "Major axis of the detection ellipse, in metres",
            "title": "Diameter",
            "type": "number"
          },
          "intensity": {
            "description": "DWD mesocyclone intensity class",
            "title": "Intensity",
            "type": "integer"
          },
          "lat": {
            "description": "EPSG:3857 northing, in metres",
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "EPSG:3857 easting, in metres",
            "title": "Lon",
            "type": "number"
          },
          "time": {
            "description": "Detection id: milliseconds since the epoch, plus an index",
            "title": "Time",
            "type": "integer"
          }
        },
        "required": [
          "lat",
          "lon",
          "diameter",
          "time",
          "intensity"
        ],
        "title": "Mesocyclone",
        "type": "object"
      },
      "NetworkCoverage": {
        "description": "Where one network answers, and what of its country is cut out of DWD's tiles.",
        "properties": {
          "dwd_hole": {
            "$ref": "#/components/schemas/Rings",
            "description": "The part of its country cut out of DWD's observation tiles."
          },
          "exclusive": {
            "$ref": "#/components/schemas/Rings",
            "description": "Where this network's composite alone is drawn."
          }
        },
        "required": [
          "exclusive",
          "dwd_hole"
        ],
        "title": "NetworkCoverage",
        "type": "object"
      },
      "NetworkRefresh": {
        "description": "A nudge that one EUMETNET network's composite has been re-rendered.\n\nDeliberately not a `Poke`, for the reason `CellsRefresh` is not one: the\nfrontend's `poke` handler reloads DWD's whole radar timeseries, and a\nnetwork composite lands every minute or two. Clients refetch only that\nnetwork's frame.",
        "properties": {
          "network": {
            "description": "Which network: `ch` MeteoSwiss, `fr` Meteo-France, `cz` CHMI, `pl` IMGW, `eu` the merged composite of every network",
            "enum": [
              "ch",
              "fr",
              "cz",
              "pl",
              "eu"
            ],
            "title": "Network",
            "type": "string"
          }
        },
        "required": [
          "network"
        ],
        "title": "NetworkRefresh",
        "type": "object"
      },
      "Platform": {
        "description": "Which push provider a client is registered with.",
        "enum": [
          "ios",
          "android"
        ],
        "title": "Platform",
        "type": "string"
      },
      "Poke": {
        "description": "A nudge that a tile product has been re-rendered, and should be refetched.",
        "properties": {
          "refresh": {
            "enum": [
              "radar",
              "nowcast",
              "precipitation_types",
              "lightning_mvt"
            ],
            "title": "Refresh",
            "type": "string"
          }
        },
        "required": [
          "refresh"
        ],
        "title": "Poke",
        "type": "object"
      },
      "PrecipitationTypes": {
        "description": "Metadata for the precipitation-type raster overlay.",
        "properties": {
          "processed_time": {
            "title": "Processed Time",
            "type": "integer"
          },
          "tile_id": {
            "title": "Tile Id",
            "type": "string"
          },
          "upstream_time": {
            "title": "Upstream Time",
            "type": "integer"
          },
          "values": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClassTiles"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the tile set's bytes mean: HG classes. Absent on frames rendered in RGBA."
          }
        },
        "required": [
          "tile_id",
          "upstream_time",
          "processed_time"
        ],
        "title": "PrecipitationTypes",
        "type": "object"
      },
      "RadarFrame": {
        "description": "One timestep of the radar/nowcast series.",
        "properties": {
          "dbz": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dbz"
          },
          "dbzMax": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dbzmax"
          },
          "dbzMin": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Dbzmin"
          },
          "filename": {
            "title": "Filename",
            "type": "string"
          },
          "processed_time": {
            "title": "Processed Time",
            "type": "integer"
          },
          "source": {
            "$ref": "#/components/schemas/FrameSource"
          },
          "tile_id": {
            "title": "Tile Id",
            "type": "string"
          },
          "tiles": {
            "anyOf": [
              {
                "additionalProperties": {
                  "$ref": "#/components/schemas/TileRows"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Which tiles exist, by zoom level. Tiles that would be fully transparent are not rendered, so a client asking for every tile in the grid is refused most of them on a dry day; with this it need not ask. Absent on frames rendered before the index existed, which means every tile may exist.",
            "title": "Tiles"
          },
          "upstream_time": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "When the radars measured what this frame shows, unix seconds: for a network's composite, its newest scan. The cutaway volumes carry the same time as `reference_time`, so a client can tell a volume from an older scan than the frame under it. Absent on frames recorded without one.",
            "title": "Upstream Time"
          },
          "values": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ValueTiles"
              },
              {
                "type": "null"
              }
            ],
            "description": "What the tile set's bytes mean: single-band RVP6. Absent on frames rendered in RGBA."
          }
        },
        "required": [
          "processed_time",
          "tile_id",
          "source",
          "filename"
        ],
        "title": "RadarFrame",
        "type": "object"
      },
      "RadarFrames": {
        "description": "A series of radar timesteps, keyed by unix time.",
        "properties": {
          "frames": {
            "additionalProperties": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/RadarFrame"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Frames",
            "type": "object"
          },
          "networks": {
            "additionalProperties": {
              "additionalProperties": {
                "$ref": "#/components/schemas/RadarFrame"
              },
              "type": "object"
            },
            "description": "meteocool's own composites of the EUMETNET networks (`ch`, `fr`, `cz`, `pl`), each keyed by the observed steps of `frames` it has a composite for -- the one measured nearest the step, and on the newest step the newest one, while it is fresh. None of them has a forecast, so no forecast step is ever here.",
            "title": "Networks",
            "type": "object"
          },
          "replay": {
            "default": false,
            "description": "Whether this stack is replaying a recorded window rather than ingesting live weather. Every timestamp is rewritten to the present, so nothing else in this response distinguishes the two -- which is the point, and the reason a client has to be told rather than left to work it out.",
            "title": "Replay",
            "type": "boolean"
          },
          "server_time": {
            "title": "Server Time",
            "type": "integer"
          }
        },
        "required": [
          "frames",
          "server_time"
        ],
        "title": "RadarFrames",
        "type": "object"
      },
      "Rings": {
        "items": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "type": "array"
        },
        "type": "array"
      },
      "SnowRefresh": {
        "description": "A nudge that the snowfield overlay has been re-rendered.",
        "properties": {
          "refresh": {
            "const": "overlay",
            "title": "Refresh",
            "type": "string"
          }
        },
        "required": [
          "refresh"
        ],
        "title": "SnowRefresh",
        "type": "object"
      },
      "StatusResponse": {
        "description": "A plain success acknowledgement.",
        "properties": {
          "message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Message"
          },
          "success": {
            "title": "Success",
            "type": "boolean"
          }
        },
        "required": [
          "success"
        ],
        "title": "StatusResponse",
        "type": "object"
      },
      "Strike": {
        "description": "One lightning strike, broadcast as the `lightning` event.",
        "properties": {
          "lat": {
            "description": "EPSG:3857 northing, in metres",
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "description": "EPSG:3857 easting, in metres",
            "title": "Lon",
            "type": "number"
          },
          "time": {
            "description": "Strike time, milliseconds since the epoch",
            "title": "Time",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon",
          "time"
        ],
        "title": "Strike",
        "type": "object"
      },
      "TelemetryReading": {
        "description": "A barometric reading submitted alongside a location.",
        "properties": {
          "accuracy": {
            "default": 0.0,
            "title": "Accuracy",
            "type": "number"
          },
          "altitude": {
            "title": "Altitude",
            "type": "number"
          },
          "device": {
            "anyOf": [
              {
                "maxLength": 128,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Device"
          },
          "lat": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Lat",
            "type": "number"
          },
          "lon": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Lon",
            "type": "number"
          },
          "pressure": {
            "title": "Pressure",
            "type": "number"
          },
          "timestamp": {
            "title": "Timestamp",
            "type": "number"
          },
          "verticalAccuracy": {
            "title": "Verticalaccuracy",
            "type": "number"
          }
        },
        "required": [
          "lat",
          "lon",
          "altitude",
          "verticalAccuracy",
          "pressure",
          "timestamp"
        ],
        "title": "TelemetryReading",
        "type": "object"
      },
      "TileRows": {
        "description": "Which tiles of one zoom level exist, as a bitmap over a rectangle.\n\n`x` and `y` are the rectangle's corner in the numbering the tile URL uses\n(XYZ x, TMS y), `w` and `h` its size in tiles, and `bits` one bit per tile\nof it, row major from that corner, most significant bit first, base64.",
        "properties": {
          "bits": {
            "title": "Bits",
            "type": "string"
          },
          "h": {
            "title": "H",
            "type": "integer"
          },
          "w": {
            "title": "W",
            "type": "integer"
          },
          "x": {
            "title": "X",
            "type": "integer"
          },
          "y": {
            "title": "Y",
            "type": "integer"
          }
        },
        "required": [
          "x",
          "y",
          "w",
          "h",
          "bits"
        ],
        "title": "TileRows",
        "type": "object"
      },
      "Unregister": {
        "description": "A request to forget a push client.",
        "properties": {
          "origin": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Origin"
          },
          "token": {
            "maxLength": 192,
            "minLength": 32,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "Unregister",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "ValueTiles": {
        "description": "What a frame's tile set holds when it is values, not colours.",
        "properties": {
          "encoding": {
            "const": "rvp6-u8",
            "description": "Single-band 8-bit greyscale PNG; pixel = RVP6 = (dBZ + 32.5) * 2, clipped to 0..255; 0 draws nothing.",
            "title": "Encoding",
            "type": "string"
          },
          "tile_id": {
            "description": "The tile set, at the same place as `tile_id`'s.",
            "title": "Tile Id",
            "type": "string"
          }
        },
        "required": [
          "tile_id",
          "encoding"
        ],
        "title": "ValueTiles",
        "type": "object"
      },
      "VectorOverlay": {
        "description": "Metadata for a vector tile overlay.",
        "properties": {
          "active": {
            "title": "Active",
            "type": "boolean"
          },
          "tile_id": {
            "title": "Tile Id",
            "type": "string"
          },
          "upstream_time": {
            "title": "Upstream Time",
            "type": "integer"
          }
        },
        "required": [
          "active",
          "tile_id",
          "upstream_time"
        ],
        "title": "VectorOverlay",
        "type": "object"
      },
      "VolumesRefresh": {
        "description": "A nudge that one composite scan's radar volumes have been built.\n\nDeliberately not a third `cells`, though `/cells/volumes` serves them: that\nevent has the frontend refetch the flat map's tracks and the 3D map's cells\ntoo, and the volumes do not follow KONRAD3D. They are built from the DMAX\ncomposite and land tens of seconds after `data` announced the same scan's\ncells -- and a scan in which KONRAD3D warned about nothing can still have\nsome. Clients refetch `/cells/volumes`.",
        "properties": {
          "reference_time": {
            "description": "Time of the composite scan the volumes were built from, milliseconds since the epoch",
            "title": "Reference Time",
            "type": "integer"
          }
        },
        "required": [
          "reference_time"
        ],
        "title": "VolumesRefresh",
        "type": "object"
      }
    }
  },
  "info": {
    "contact": {
      "email": "valentin@meteocool.com"
    },
    "description": "\nWelcome to the meteocool backend. You are free to use our raw and aggregated\ndata for your private and server applications. If you are planning on releasing\na publicly available application, please cache these endpoints on your side\nrather than having your users hit them directly.\n\n## Compatibility\n\nWe cannot guarantee consistency or availability of these endpoints, but `/v3/`\nendpoints will not introduce breaking changes soon. Most are rate limited,\nespecially on error responses.\n\n## Attributions\n\nAlways attribute the original data sources. You, not us, are responsible to the\ncopyright holders if you fail to.\n\n* Radar, precipitation types and nowcast data: **DWD**\n* Lightning data: **blitzortung.org**\n\nWe would appreciate an attribution to meteocool too.\n\n## Mobile endpoints\n\nEndpoints tagged `mobile` are documented for completeness; they need a valid\nAPNS or Firebase push token and are write-only, because the read channel is the\nnotification delivered to the device.\n",
    "title": "meteocool Severe Weather API",
    "version": "4.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/dl": {
      "get": {
        "operationId": "download_dl_get",
        "parameters": [
          {
            "in": "header",
            "name": "user-agent",
            "required": false,
            "schema": {
              "default": "",
              "title": "User-Agent",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Redirect to the app store for the visitor's platform."
      }
    },
    "/v3/lightning/baseline": {
      "get": {
        "description": "Every strike recorded since `baseline`, as a unix timestamp.",
