        "tags": [
          "lightning"
        ]
      }
    },
    "/v3/lightning/stats": {
      "get": {
        "description": "Per-minute strike counts inside a polygon, for the last half hour.",
        "operationId": "stats_v3_lightning_stats_get",
        "parameters": [
          {
            "in": "query",
            "name": "bbox",
            "required": true,
            "schema": {
              "title": "Bbox",
              "type": "string"
            }
          }
        ],
        "responses": {
