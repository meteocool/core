            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LocationUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Register or refresh a push client.",
        "tags": [
          "mobile"
        ]
      }
    },
    "/v3/radar/classification": {
      "get": {
        "description": "The most recent precipitation-type tile set.\n\nServed at /api/precip_types/ by the old Flask service, which this replaces.",
        "operationId": "classification_v3_radar_classification_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PrecipitationTypes"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Precipitation-type overlay metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/coverage": {
      "get": {
        "description": "Each EUMETNET network's exclusive coverage, and the part of its country cut out of DWD's tiles.\n\nThe map clips each network's layer to its coverage and holes DWD's tiles\nwith the rest, and the server decides by the same shapes which domain a\npoint belongs to (ADR 0012), so the two cannot disagree. They change only\nwith a release.",
        "operationId": "coverage_v3_radar_coverage_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Coverages"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Which network's composite is drawn where.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/czechia": {
      "get": {
        "description": "The newest Czech reflectivity composite -- one frame, not a timeseries.\n\nCHMI's two radars, composited by meteocool from the lowest tilt of each\nvolume; see `/switzerland` for why this is a route of its own.",
        "operationId": "czechia_v3_radar_czechia_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrame"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Czech reflectivity tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/europe": {
      "get": {
        "description": "The newest merged composite of every network's lowest tilts -- one frame, not a timeseries.\n\nDWD's, MeteoSwiss's, Meteo-France's, CHMI's and IMGW's radars on one grid,\ncomposited by meteocool every few minutes on a background worker. A\nproduct behind a setting: the map's own arrangement of five products\nstays, and this is offered beside it. Not in `/timeseries`: it keeps no\nhistory, and every client would carry it otherwise.",
        "operationId": "europe_v3_radar_europe_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrame"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Merged European reflectivity tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/france": {
      "get": {
        "description": "The newest French reflectivity composite -- one frame, not a timeseries.\n\nMeteo-France's twenty-three radars, composited by meteocool from their\nlowest tilts; see `/switzerland` for why this is a route of its own.",
        "operationId": "france_v3_radar_france_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrame"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "French reflectivity tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/poland": {
      "get": {
        "description": "The newest Polish reflectivity composite -- one frame, not a timeseries.\n\nIMGW's ten radars, composited by meteocool from the lowest tilt of each\nvolume; see `/switzerland` for why this is a route of its own.",
        "operationId": "poland_v3_radar_poland_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrame"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Polish reflectivity tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/snow": {
      "get": {
        "description": "The most recent snowfield vector tile set.",
        "operationId": "snow_v3_radar_snow_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VectorOverlay"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Snowfield overlay metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/switzerland": {
      "get": {
        "description": "The newest Swiss reflectivity composite -- one frame, not a timeseries.\n\nA route of its own beside `/timeseries`, which carries this network's\npast too (`networks.ch`): a client refetches this whenever a radar reports\n-- every minute or two, on the `network` socket event -- and the whole\ntimeseries only when DWD publishes. Same `RadarFrame` shape as every other\nframe here, so the client needs one type and one tile-URL builder for\nevery network.",
        "operationId": "switzerland_v3_radar_switzerland_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrame"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Swiss reflectivity tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/radar/timeseries": {
      "get": {
        "description": "Tile metadata for each timestep in a window, past and forecast.\n\nWith `lat` and `lon`, each frame also carries the dBZ at that point. With\n`network` as well, it is that network's reading wherever it has a composite\nfor the step -- which is every observed step, while its ingest is running\n-- and DWD's everywhere else, the forecast included. The client names the\nnetwork because it is the one that knows which draws where: the borders are\n`extents.ts`'s, and a point sampled from a network the map is not showing\nthere would put bars under the chart that nothing on the map agrees with.",
        "operationId": "timeseries_v3_radar_timeseries_get",
        "parameters": [
          {
            "in": "query",
            "name": "start",
            "required": false,
            "schema": {
              "default": 0,
              "title": "Start",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "end",
            "required": false,
            "schema": {
              "default": 0,
              "title": "End",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "lat",
            "required": false,
            "schema": {
              "default": 0.0,
              "title": "Lat",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "lon",
            "required": false,
            "schema": {
              "default": 0.0,
              "title": "Lon",
              "type": "number"
            }
          },
          {
            "in": "query",
            "name": "network",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "ch",
                    "fr",
                    "cz",
                    "pl"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Network"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RadarFrames"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Radar and nowcast tile metadata.",
        "tags": [
          "radar"
        ]
      }
    },
    "/v3/telemetry/pressure": {
      "post": {
        "description": "Accept a barometric reading, and keep nothing of it.",
        "operationId": "post_pressure_v3_telemetry_pressure_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryReading"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Submit a barometric reading.",
        "tags": [
          "telemetry"
        ]
      }
    }
  }
}
