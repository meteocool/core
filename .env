# Build configuration. Committed on purpose: no secrets live here.
# Override locally with .env.local, which is gitignored.

# Version of the Protomaps basemap tileset served from map.meteocool.com.
VITE_MAP_VERSION=20260104

# Version of the Mapterhorn terrain archive served from the same host.
VITE_TERRAIN_VERSION=20261002

# Features offered in the UI (src/features.ts): "1" offers one, anything else
# leaves it out. On for every mode but production, which .env.production
# turns them off for: next and demo show them, meteocool.com does not.
VITE_FEATURE_STORM_STYLES=1
VITE_FEATURE_STUDIO=1
VITE_FEATURE_METEOAIR=1
